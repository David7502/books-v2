{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "books-v2",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2026-11-07",
	"upload_source_maps": true,
	"observability": {
	  "enabled": true,
	  "logs": { "enabled": true },
	  "traces": { "enabled": true }
	},
	"assets": {
	  "not_found_handling": "single-page-application",
	  "run_worker_first": ["/api/*", "/mcp"]
	},
	"d1_databases": [
	  { "binding": "DB", "database_name": "books-v2", "remote": false }
	],
	"vars": {
	  "TEAM_DOMAIN": "",
	  "POLICY_AUD": "",
	  "ACCESS_LOCAL_EXEMPT": "",
	  "MCP_HOSTNAME": "",
	  "MCP_POLICY_AUD": "",
	  "MCP_SERVICE_CLIENT_ID": ""
	},
	"r2_buckets": [
	  { "binding": "COVERS", "bucket_name": "books-v2-covers", "remote": false }
	],
  
	"env": {
	  "production": {
		"routes": [
		  { "pattern": "books.davidguillo.fr", "custom_domain": true}, 
		  { "pattern": "mcp.davidguillo.fr", "custom_domain": true }
		],
		"workers_dev": false,
		"preview_urls": false,
		"assets": {
		  "not_found_handling": "single-page-application",
		  "run_worker_first": ["/api/*", "/mcp"]
		},
		"d1_databases": [
		  {
			"binding": "DB",
			"database_name": "BOOKS_PROD",
			"database_id": "d59c1214-a990-4294-a39f-8ed9b8032dd5",
			"remote": true
		  }
		],
		"vars": {
		  "TEAM_DOMAIN": "https://davidguillo.cloudflareaccess.com",
		  "POLICY_AUD": "623528a95f513173636ed6cbdc65cb293ea0d4847321db448871cd7598492902",
		  "ACCESS_LOCAL_EXEMPT": "",
		  "MCP_HOSTNAME": "mcp.davidguillo.fr",
		  "MCP_POLICY_AUD": "35f57a73acc4fb5629dccaf0c78f557fe3638ca529275ab0205956ec54dcb549",
		  "MCP_SERVICE_CLIENT_ID": "9075cd2821f716cdc03206e19b22249e.access"
		},
		"r2_buckets": [
		  { "binding": "COVERS", "bucket_name": "books-prod", "remote": true }
		]
	  }
	}
  }