{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "books-v2",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-11-07",
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "books-v2",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "COVERS",
      "bucket_name": "books-v2-covers",
      "remote": false
    }
  ]
}
