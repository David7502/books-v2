{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "books-v2",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-11-07",
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
